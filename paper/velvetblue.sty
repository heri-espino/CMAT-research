\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{velvetblue}[2026/09/15 Personal academic draft style]

% ============================================================
% Options
% ============================================================

\newif\ifVelvetMath
\newif\ifVelvetDraft

% Defaults:
%   general citations
%   draft diagnostics enabled
\VelvetMathfalse
\VelvetDrafttrue

\DeclareOption{general}{\VelvetMathfalse}
\DeclareOption{math}{\VelvetMathtrue}

\DeclareOption{draft}{\VelvetDrafttrue}
\DeclareOption{final}{\VelvetDraftfalse}

\ProcessOptions\relax

% ============================================================
% Mathematics
% ============================================================

\RequirePackage{amsmath}

% ============================================================
% Typography
% ============================================================

\RequirePackage{libertinus}

\RequirePackage[
    protrusion=false,
    expansion=false
]{microtype}

% Additional flexibility before TeX produces an overfull line.
\emergencystretch=2em

% ============================================================
% Page geometry
%
% A4:
%   210 mm × 297 mm
%
% Text block:
%   148.5 mm × 210 mm
%
% Linear scale:
%   1/sqrt(2)
%
% Area ratio:
%   1/2
% ============================================================

\RequirePackage[
    a4paper,
    textwidth=148.5mm,
    textheight=210mm,
    hcentering,
    vcentering
]{geometry}

% ============================================================
% Figures and tables
% ============================================================

\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{caption}
\RequirePackage{pdflscape}

% ============================================================
% Color
% ============================================================

\RequirePackage{xcolor}

\definecolor{VelvetBlue}{HTML}{00166C}

% ============================================================
% Bibliography
% ============================================================

\ifVelvetMath

    % Mathematical drafts:
    % compact numerical citations, e.g. [3--7, 11]
    \RequirePackage[
        backend=biber,
        style=numeric-comp,
        sorting=none,
        maxbibnames=99,
        giveninits=true,
        doi=true,
        url=false,
        isbn=false,
        eprint=false
    ]{biblatex}

\else

    % General / ML / statistics drafts:
    % compact author-year citations
    \RequirePackage[
        backend=biber,
        style=authoryear-comp,
        sorting=nyt,
        maxcitenames=2,
        maxbibnames=99,
        giveninits=true,
        dashed=false,
        doi=true,
        url=false,
        isbn=false,
        eprint=false
    ]{biblatex}

\fi

% natbib-like aliases
\let\citep\parencite
\let\citet\textcite

% ============================================================
% URLs and hyperlinks
% ============================================================

\RequirePackage{xurl}

\RequirePackage[
    colorlinks=true,
    linkcolor=VelvetBlue,
    citecolor=VelvetBlue,
    urlcolor=VelvetBlue
]{hyperref}

\RequirePackage[
    nameinlink,
    noabbrev
]{cleveref}

% ============================================================
% Draft diagnostics
% ============================================================

\ifVelvetDraft
    \overfullrule=5pt
\else
    \overfullrule=0pt
\fi
