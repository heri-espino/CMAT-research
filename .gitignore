# Generated local pipeline/build outputs are not source code.
cmat_analysis/outputs/
brainstorm/**/build/
paper/build/

# Raw CSVs are excluded by default. Aggregated/releasable CSVs may be force-added
# only after privacy review. Retained aggregate outputs may live in brainstorms.
*.csv
!outputs/aggregated/**/*.csv
!brainstorm/**/tables/*.csv
!results/**/*.csv

# Heavy literature snapshot
# Local literature PDFs and Docling assets may be preserved in the canonical
# literature library when appropriate, but repository visibility does not grant
# redistribution rights. Check applicable licences before public reuse.

# Local raw-data directories
data/raw/
data/private/
data/internal/
